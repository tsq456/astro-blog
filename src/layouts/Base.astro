---
const {
  title = "个人博客",
  showTopbar = false,
  backHref = "/",
  backLabel = "返回首页",
  contentClass = "",
} = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Spectral:wght@300;400;600;700&family=Manrope:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="container fade-in">
      {showTopbar ? (
        <div class="topbar">
          <span class="logo">Personal Notes</span>
          <a class="btn-pill" href={backHref}>{backLabel}</a>
        </div>
      ) : null}
      <div class={`content ${contentClass}`}>
        <slot />
      </div>
      <footer class="footer">
        <div>
          <div class="signature">个人博客</div>
          <div>持续更新 · 记录长期主义者的生活与思考</div>
        </div>
        <div>
          <div>订阅：newsletter@example.com</div>
          <div>社交：Instagram / GitHub / X</div>
        </div>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  @import "../styles/theme.css";
</style>

<style>
  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--line);
    padding-bottom: 20px;
    margin-bottom: 36px;
  }

  .content {
    max-width: var(--content-width, 1040px);
  }
</style>
