---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<Base title={`博客详情 | ${post.data.title}`}>
  <div class="topbar">
    <span class="logo">Personal Notes</span>
    <a class="btn-pill" href="/">返回首页</a>
  </div>

  <article>
    <header>
      <h1>{post.data.title}</h1>
      <div class="meta">{post.data.date.toLocaleDateString("zh-CN", { year: "numeric", month: "2-digit", day: "2-digit" }).replace(/\//g, "-")} · {post.data.category} · 阅读 {post.data.readTime}</div>
      <p class="lead">{post.data.excerpt}</p>
    </header>

    {post.data.hero ? (
      <div class="hero">
        <Image
          class="hero-image"
          src={post.data.hero}
          alt="抽象风景"
          width={1200}
          height={720}
        />
      </div>
    ) : null}

    <Content />
  </article>

  <footer class="footer">
    <div>
      <div class="signature">个人博客</div>
      <div>持续更新 · 记录长期主义者的生活与思考</div>
    </div>
    <div>
      <div>订阅：newsletter@example.com</div>
      <div>社交：Instagram / GitHub / X</div>
    </div>
  </footer>
</Base>

<style>
  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--line);
    padding-bottom: 20px;
    margin-bottom: 36px;
  }

  h1 {
    font-family: "Spectral", "Times New Roman", serif;
    font-size: clamp(2.4rem, 4vw, 3.2rem);
    margin: 12px 0 8px;
    letter-spacing: 0.02em;
  }

  .meta {
    color: var(--muted);
    font-size: 0.95rem;
    margin-bottom: 24px;
  }

  .lead {
    font-size: 1.1rem;
    color: #343b44;
    margin-bottom: 28px;
  }

  .hero {
    margin: 26px 0 34px;
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid var(--line);
    box-shadow: 0 14px 30px var(--shadow);
  }

  .hero-image {
    width: 100%;
    display: block;
    height: 320px;
    object-fit: cover;
  }

  :global(h2),
  :global(h3),
  :global(h4) {
    font-family: "Spectral", "Times New Roman", serif;
    margin: 32px 0 12px;
    letter-spacing: 0.01em;
  }

  :global(h2) { font-size: 1.7rem; }
  :global(h3) { font-size: 1.3rem; }
  :global(h4) { font-size: 1.1rem; }

  :global(p) {
    margin: 0 0 18px;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    align-items: start;
    margin: 20px 0 28px;
  }

  .card {
    background: #fffaf2;
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 18px 20px;
  }

  .caption {
    font-size: 0.9rem;
    color: var(--muted);
    margin-top: 10px;
  }

  .quote {
    margin: 28px 0;
    padding: 18px 22px;
    border-left: 3px solid var(--accent);
    background: #fffaf3;
    color: #3b3f45;
  }

  .toc {
    background: #fffdf8;
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 16px 18px;
    margin: 24px 0 32px;
  }

  .toc ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 6px;
    color: var(--muted);
    font-size: 0.95rem;
  }

  @media (max-width: 820px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .hero-image {
      height: 240px;
    }
  }
</style>
