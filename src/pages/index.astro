---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("posts"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);

const formatDate = (date) =>
  date
    .toLocaleDateString("zh-CN", {
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
    })
    .replace(/\//g, "-");
---

<Base title="个人博客 | 首页">
  <header class="hero">
    <div>
      <span class="logo">Personal Notes</span>
      <h1>以写作为灯，照亮思考的路径</h1>
      <p class="lead">这里是我的个人博客主页：记录研究、产品、生活与阅读的交汇点。温暖、克制、保持好奇。</p>
      <nav>
        <a class="btn-pill" href="/blog">博客</a>
        <a class="btn-pill" href="#">专题</a>
        <a class="btn-pill" href="/about">关于我</a>
        <a class="btn-pill" href="#">订阅</a>
      </nav>
    </div>
    <div class="intro-card">
      <div class="section-title">本周在关注</div>
      <div class="intro-meta">
        <div>主题：AI 产品体验与创作流程</div>
        <div>更新：每周二 / 周五</div>
        <div>所在地：上海 / 远程</div>
        <div>邮件：hello@example.com</div>
      </div>
    </div>
  </header>

  <section>
    <div class="section-title">最新文章</div>
    <div class="posts">
      {posts.map((post) => (
        <article class="post card-hover">
          <div>
            <div class="meta">{formatDate(post.data.date)} · {post.data.category}</div>
            <h3>{post.data.title}</h3>
            <p class="excerpt">{post.data.excerpt}</p>
          </div>
          <a class="tag" href={`/blog/${post.slug}`}>Read</a>
        </article>
      ))}
    </div>
  </section>

  <section class="grid">
    <div class="about">
      <div class="section-title">关于我</div>
      <p>我是一个专注产品体验与内容策略的写作者，记录探索中的真实细节。喜欢把复杂问题拆成可执行的小步，让“想法”真正落地。</p>
      <div style="margin-top: 18px; display: flex; flex-wrap: wrap; gap: 10px;">
        <span class="pill">产品思维</span>
        <span class="pill">写作系统</span>
        <span class="pill">长期主义</span>
        <span class="pill">AI 工作流</span>
      </div>
    </div>
  </section>

  <footer class="footer">
    <div>
      <div class="signature">个人博客</div>
      <div>持续更新 · 记录长期主义者的生活与思考</div>
    </div>
    <div>
      <div>订阅：newsletter@example.com</div>
      <div>社交：Instagram / GitHub / X</div>
    </div>
  </footer>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 48px;
    align-items: center;
    border-bottom: 1px solid var(--line);
    padding-bottom: 40px;
    margin-bottom: 48px;
  }

  h1 {
    font-family: "Spectral", "Times New Roman", serif;
    font-size: clamp(2.6rem, 4vw, 3.6rem);
    letter-spacing: 0.02em;
    margin: 16px 0 12px;
  }

  .lead {
    font-size: 1.1rem;
    color: var(--muted);
    margin: 0 0 24px;
  }

  nav {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 18px;
  }

  .intro-card {
    background: #fffaf2;
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 28px;
    box-shadow: 0 10px 24px var(--shadow);
  }

  .intro-meta {
    display: grid;
    gap: 10px;
    font-size: 0.95rem;
    color: var(--muted);
  }

  .posts {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px;
  }

  .post {
    background: #fffdf8;
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 22px 24px;
    min-height: 220px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .post h3 {
    font-family: "Spectral", "Times New Roman", serif;
    font-size: 1.5rem;
    margin: 8px 0 12px;
  }

  .post .meta {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .post .excerpt {
    color: #38404a;
    font-size: 0.98rem;
    margin: 0 0 18px;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    margin-top: 56px;
    align-items: start;
  }

  .about {
    background: #fffaf2;
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 24px 26px;
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
    }

    .posts {
      grid-template-columns: 1fr;
    }
  }
</style>
