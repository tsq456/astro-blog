---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import { buildExcerpt } from "../utils/excerpt";
import { slugifyCategory } from "../utils/slug";

const posts = (await getCollection("posts"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const formatDate = (date) =>
  date
    .toLocaleDateString("zh-CN", {
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
    })
    .replace(/\//g, "-");
---

<Base title="个人博客 | 首页" contentClass="content--list">
  <header class="hero">
    <div>
      <span class="logo">Personal Notes</span>
      <h1>以写作为灯，照亮思考的路径</h1>
      <p class="lead">这里是我的个人博客主页：记录研究、产品、生活与阅读的交汇点。温暖、克制、保持好奇。</p>
      <nav>
        <a class="btn-pill" href="/">首页</a>
        <a class="btn-pill" href="/archive">归档</a>
        <a class="btn-pill" href="/about">关于我</a>
        <a class="btn-pill" href="#">订阅</a>
      </nav>
    </div>
  </header>

  <section>
    <div class="section-title">文章</div>
    <div class="posts">
      {posts.map((post) => (
        <article class="post">
          <a class="card-link" href={`/blog/${post.slug}`} aria-label={post.data.title}></a>
          <div>
            <h3>{post.data.title}</h3>
            <p class="excerpt">{buildExcerpt(post.body)}</p>
            <div class="meta">
              <time datetime={post.data.date.toISOString()}>
                {formatDate(post.data.date)}
              </time>
              <span> · </span>
              <a class="text-link" href={`/category/${slugifyCategory(post.data.category)}`}>{post.data.category}</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 48px;
    align-items: center;
    border-bottom: 1px solid var(--line);
    padding-bottom: 40px;
    margin-bottom: 48px;
  }

  h1 {
    font-family: "Spectral", "Times New Roman", serif;
    font-size: clamp(2.6rem, 4vw, 3.6rem);
    letter-spacing: 0.02em;
    margin: 16px 0 12px;
  }

  .lead {
    font-size: 1.1rem;
    color: var(--muted);
    margin: 0 0 24px;
  }

  nav {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 18px;
  }

  .intro-card {
    background: #fffaf2;
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 28px;
    box-shadow: 0 10px 24px var(--shadow);
  }

  .intro-meta {
    display: grid;
    gap: 10px;
    font-size: 0.95rem;
    color: var(--muted);
  }

  .posts {
    display: grid;
    grid-template-columns: 1fr;
    gap: 22px;
  }

  .post {
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .post:first-child {
    padding-top: 0;
  }

  .post:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .post h3 {
    font-family: "Spectral", "Times New Roman", serif;
    font-size: 1.6rem;
    margin: 0 0 10px;
    transition: color 0.2s ease;
  }

  .post:hover h3 {
    color: var(--accent);
  }

  .post .excerpt {
    color: #38404a;
    font-size: 0.98rem;
    margin: 0 0 10px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post .meta {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .post .meta a {
    position: relative;
    z-index: 2;
  }

  .card-link {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .post {
    position: relative;
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
    }
  }
</style>
